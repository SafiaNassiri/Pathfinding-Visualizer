[configuration]
entry_symbol = "pathfinding_library_init"
compatibility_minimum = 4.1

[libraries]
windows.debug.x86_64 = "res://gdextension/bin/libpathfinding.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://gdextension/bin/libpathfinding.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://gdextension/bin/libpathfinding.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://gdextension/bin/libpathfinding.linux.template_release.x86_64.so"
macos.debug = "res://gdextension/bin/libpathfinding.macos.template_debug.dylib"
macos.release = "res://gdextension/bin/libpathfinding.macos.template_release.dylib"
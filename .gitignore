# ==========================================
# Godot 4 Core Ignored Files
# ==========================================
# Godot internal cache and imported resource data
.godot/

# Export presets (often contains keystores, export credentials, or local signing keys)
# Uncomment the line below if export_presets.cfg contains sensitive credentials
# export_presets.cfg

# Export outputs
*.apk
*.aab
*.exe
*.zip
*.tar.gz
*.html
*.js
*.wasm
*.pck

# Translation generation source files
*.translation

# ==========================================
# C++ / SCons / GDExtension Build Artifacts
# ==========================================
# SCons tracking files
**/.sconsign.dblite
**/.scons_temp/
**/config.log

# Object files & intermediate build files
**/*.o
**/*.obj
**/*.os
**/*.a
**/*.lib
**/*.exp
**/*.pdb
**/*.ilk
**/*.idb

# Compiled dynamic libraries generated by SCons
gdextension/bin/
bin/

# godot-cpp generated files and precompiled artifacts
gdextension/godot-cpp/bin/
gdextension/godot-cpp/gen/

# ==========================================
# IDE & System Files
# ==========================================
# VS Code
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio (MSVC)
.vs/
*.sln.docstates
*.suo
*.user
*.userosv
*.vcxproj.user

# CLion / JetBrains
.idea/
cmake-build-*/

# OS-generated metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Crash logs & backups
*.log
*.bak
*.swp
*~